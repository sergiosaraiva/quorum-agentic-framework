# Copy to .env (gitignored). Never commit real values. Export it for docker compose and scripts: set -a; source .env; set +a
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# KB tooling (scripts/kb), pg backend only. Built from the variables above when you run `set -a; source .env; set +a`.
# A password with URL-reserved characters (@ : / ?) must be percent-encoded here.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/app
KB_BACKEND=local

# Embeddings: hash (offline demo stub) or http (OpenAI-compatible endpoint)
EMBED_PROVIDER=hash
EMBED_DIM=384
# EMBED_BASE_URL=
# EMBED_MODEL=
# EMBED_API_KEY=

# Optional keys. Nothing here is required to run the template. Leave a value empty and the feature is skipped:
#   ANTHROPIC_API_KEY  GitHub AI review: an environment secret of `ai-review` (never in this file); needs the repository variable AI_REVIEW_ENABLED=true. Unset: the review is skipped.
#                      Local review (scripts/ai_review_local.py) uses your own `claude` sign-in; no `claude` CLI: skipped.
#   EMBED_API_KEY      Only for EMBED_PROVIDER=http. The default hash provider needs no key.
