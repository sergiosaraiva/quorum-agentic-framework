# Copy to .env (gitignored). Never commit real values. Export it for docker compose and scripts: set -a; source .env; set +a
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# KB tooling (scripts/kb). Example: postgresql://app_user:<password>@localhost:5432/app
DATABASE_URL=
KB_BACKEND=local

# Embeddings: hash (offline demo stub) or http (OpenAI-compatible endpoint)
EMBED_PROVIDER=hash
EMBED_DIM=384
# EMBED_BASE_URL=
# EMBED_MODEL=
# EMBED_API_KEY=
